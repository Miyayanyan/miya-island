<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MiyaIsland</AssemblyName>
    <RootNamespace>MiyaIsland</RootNamespace>
    <Version>0.7.1</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\MiyaIsland.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- ColorDialog 需要 WinForms 程序集，但不把 WinForms/Drawing 类型全局导入，避免与 WPF 同名类型冲突。 -->
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\noise.png" />
    <Resource Include="Assets\DefaultAvatar.png" />
  </ItemGroup>
</Project>
