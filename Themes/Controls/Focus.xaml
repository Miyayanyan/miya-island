<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:MiyaIsland.Controls">
  <!-- 接入时可将这些补充 token 移入 Tokens.xaml。颜色在模板中均动态引用。 -->
  <SolidColorBrush x:Key="Brush.ControlWhite" Color="White" />
  <SolidColorBrush x:Key="Brush.ControlTransparent" Color="Transparent" />
  <SolidColorBrush x:Key="Brush.LensBorder" Color="#47C8B9FF" />
  <LinearGradientBrush x:Key="Brush.LensInnerHighlight" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0.45" Color="Transparent" />
    <GradientStop Offset="1" Color="#38FFFFFF" />
  </LinearGradientBrush>
  <Color x:Key="Color.ControlShadow">Black</Color>
  <Color x:Key="Color.ControlWhite">White</Color>
  <Color x:Key="Color.ControlTransparent">Transparent</Color>
  <CornerRadius x:Key="Radius.ControlPill">999</CornerRadius>
  <CornerRadius x:Key="Radius.ControlItem">8</CornerRadius>
  <CornerRadius x:Key="Radius.ControlTrack">2</CornerRadius>
  <CornerRadius x:Key="Radius.ControlThumb">7</CornerRadius>
  <CornerRadius x:Key="Radius.ControlScrollThumb">3</CornerRadius>

  <Style x:Key="FocusRing" TargetType="{x:Type Control}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Control}">
          <Border x:Name="Ring" Margin="-4" IsHitTestVisible="False" BorderThickness="2"
                  BorderBrush="{DynamicResource Brush.Accent}" CornerRadius="{StaticResource Radius.S}" />
          <ControlTemplate.Triggers><DataTrigger Binding="{Binding KeyboardNavigation, Source={x:Static c:InputModality.State}}" Value="False"><Setter TargetName="Ring" Property="Visibility" Value="Collapsed"/></DataTrigger>
            <!-- 只读取被装饰控件的样式类型，不把它挂载到焦点视觉树。 -->
            <DataTrigger Binding="{Binding AdornedElement.Style.TargetType, RelativeSource={RelativeSource AncestorType={x:Type Adorner}}}" Value="{x:Type Button}">
              <Setter TargetName="Ring" Property="CornerRadius" Value="{StaticResource Radius.ButtonFocus}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding AdornedElement.Style.TargetType, RelativeSource={RelativeSource AncestorType={x:Type Adorner}}}" Value="{x:Type ScrollBar}">
              <Setter TargetName="Ring" Property="CornerRadius" Value="{StaticResource Radius.ControlPill}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding AdornedElement.Style.TargetType, RelativeSource={RelativeSource AncestorType={x:Type Adorner}}}" Value="{x:Type ListBoxItem}">
              <Setter TargetName="Ring" Property="CornerRadius" Value="{StaticResource Radius.ControlItem}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding AdornedElement.Style.TargetType, RelativeSource={RelativeSource AncestorType={x:Type Adorner}}}" Value="{x:Type ComboBoxItem}">
              <Setter TargetName="Ring" Property="CornerRadius" Value="{StaticResource Radius.ControlItem}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding AdornedElement.Style.TargetType, RelativeSource={RelativeSource AncestorType={x:Type Adorner}}}" Value="{x:Type ToolTip}">
              <Setter TargetName="Ring" Property="CornerRadius" Value="{StaticResource Radius.ControlItem}" />
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
