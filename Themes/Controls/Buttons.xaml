  <ControlTemplate x:Key="Button.LensTemplate" TargetType="{x:Type Button}">
    <Grid x:Name="Root" SnapsToDevicePixels="True">
      <Border Background="{DynamicResource Brush.Lens}" CornerRadius="{StaticResource Radius.ControlPill}" IsHitTestVisible="False">
        <Border.Effect><DropShadowEffect Color="{DynamicResource Color.ControlShadow}" Direction="270" ShadowDepth="3" BlurRadius="10" Opacity=".18" /></Border.Effect>
      </Border>
      <Border x:Name="BackgroundLayer" Background="{DynamicResource Brush.ControlTransparent}" CornerRadius="{StaticResource Radius.ControlPill}" RenderTransformOrigin=".5,.5">
        <Border.RenderTransform><ScaleTransform x:Name="BackgroundScale" /></Border.RenderTransform>
        <Grid>
          <Border x:Name="NormalSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Radius.ControlPill}" />
          <Border x:Name="HoverSurface" Background="{DynamicResource Brush.ControlWhite}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Radius.ControlPill}" Opacity="0" />
          <Border Background="{DynamicResource Brush.LensInnerHighlight}" CornerRadius="{StaticResource Radius.ControlPill}" IsHitTestVisible="False" />
        </Grid>
      </Border>
      <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">

        <Trigger.EnterActions><BeginStoryboard><Storyboard>
          <DoubleAnimation Storyboard.TargetName="HoverSurface" Storyboard.TargetProperty="Opacity" To=".06" Duration="0:0:0.12" />

        </Storyboard></BeginStoryboard></Trigger.EnterActions>
        <Trigger.ExitActions><BeginStoryboard><Storyboard>
          <DoubleAnimation Storyboard.TargetName="HoverSurface" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />

        </Storyboard></BeginStoryboard></Trigger.ExitActions>
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Trigger.EnterActions><BeginStoryboard><Storyboard>
          <DoubleAnimation Storyboard.TargetName="BackgroundScale" Storyboard.TargetProperty="ScaleX" To=".96" Duration="0:0:0.12" />
          <DoubleAnimation Storyboard.TargetName="BackgroundScale" Storyboard.TargetProperty="ScaleY" To=".96" Duration="0:0:0.12" />
        </Storyboard></BeginStoryboard></Trigger.EnterActions>
        <Trigger.ExitActions><BeginStoryboard><Storyboard>
          <DoubleAnimation Storyboard.TargetName="BackgroundScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12" />
