<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Focus.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <!-- 所有缩放只作用于背景层；文字和图标保持原尺寸。 -->

  <ControlTemplate x:Key="Button.GlassTemplate" TargetType="{x:Type Button}">
    <Grid x:Name="Root" SnapsToDevicePixels="True">

      <Border x:Name="BackgroundLayer" Background="{DynamicResource Brush.ControlTransparent}" CornerRadius="{StaticResource Radius.Button}" RenderTransformOrigin=".5,.5">
        <Border.RenderTransform><ScaleTransform x:Name="BackgroundScale" /></Border.RenderTransform>
        <Grid>
          <Border x:Name="NormalSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Radius.Button}" />
          <Border x:Name="HoverSurface" Background="{DynamicResource Brush.ControlHover}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Radius.Button}" Opacity="0" />
          <Border BorderBrush="{DynamicResource Brush.ControlWhite}" BorderThickness="1" CornerRadius="{StaticResource Radius.Button}" Opacity=".14" IsHitTestVisible="False">
            <Border.OpacityMask><LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop Offset="0" Color="{DynamicResource Color.ControlWhite}" />
              <GradientStop Offset=".5" Color="{DynamicResource Color.ControlTransparent}" />
            </LinearGradientBrush></Border.OpacityMask>
          </Border>
        </Grid>
      </Border>
      <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
    </Grid>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">

        <Trigger.EnterActions><BeginStoryboard><Storyboard>
          <DoubleAnimation Storyboard.TargetName="HoverSurface" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
          <DoubleAnimation Storyboard.TargetName="NormalSurface" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
        </Storyboard></BeginStoryboard></Trigger.EnterActions>
        <Trigger.ExitActions><BeginStoryboard><Storyboard>
          <DoubleAnimation Storyboard.TargetName="HoverSurface" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
          <DoubleAnimation Storyboard.TargetName="NormalSurface" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
        </Storyboard></BeginStoryboard></Trigger.ExitActions>
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Trigger.EnterActions><BeginStoryboard><Storyboard>
          <DoubleAnimation Storyboard.TargetName="BackgroundScale" Storyboard.TargetProperty="ScaleX" To=".97" Duration="0:0:0.12" />
          <DoubleAnimation Storyboard.TargetName="BackgroundScale" Storyboard.TargetProperty="ScaleY" To=".97" Duration="0:0:0.12" />
        </Storyboard></BeginStoryboard></Trigger.EnterActions>
        <Trigger.ExitActions><BeginStoryboard><Storyboard>
          <DoubleAnimation Storyboard.TargetName="BackgroundScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12" />
          <DoubleAnimation Storyboard.TargetName="BackgroundScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12" />
        </Storyboard></BeginStoryboard></Trigger.ExitActions>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value=".4" /></Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

