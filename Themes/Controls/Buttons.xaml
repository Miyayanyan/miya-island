  <Style TargetType="{x:Type Button}">
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
    <Setter Property="Background" Value="{DynamicResource Brush.Control}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Separator}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
    <Setter Property="Template" Value="{StaticResource Button.GlassTemplate}" />
  </Style>
  <Style x:Key="Button.Glass" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}" />
  <Style x:Key="Button.Primary" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{DynamicResource Brush.Primary}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.ControlWhite}" />
    <Setter Property="Template" Value="{StaticResource Button.AccentTemplate}" />
  </Style>
  <Style x:Key="Button.Danger" TargetType="{x:Type Button}" BasedOn="{StaticResource Button.Primary}">
    <Setter Property="Background" Value="{DynamicResource Brush.Danger}" />
  </Style>
  <Style x:Key="Button.Ghost" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="{DynamicResource Brush.ControlTransparent}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink2}" />
    <Setter Property="Template" Value="{StaticResource Button.GhostTemplate}" />
  </Style>
  <Style x:Key="Button.Icon" TargetType="{x:Type Button}" BasedOn="{StaticResource Button.Ghost}">
    <Setter Property="Width" Value="28" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Template" Value="{StaticResource Button.IconTemplate}" />
  </Style>
  <Style x:Key="Button.Lens" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="{DynamicResource Brush.Lens}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.LensBorder}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
    <Setter Property="Template" Value="{StaticResource Button.LensTemplate}" />
  </Style>
</ResourceDictionary>

