<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Focus.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <Style TargetType="{x:Type ToolTip}">
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
    <Setter Property="MaxWidth" Value="320" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
    <Setter Property="Template"><Setter.Value>
      <ControlTemplate TargetType="{x:Type ToolTip}">
        <Grid x:Name="Root" Margin="12">
          <Border Background="{DynamicResource Brush.PopupBase}" CornerRadius="{StaticResource Radius.ControlItem}" IsHitTestVisible="False">
            <Border.Effect><DropShadowEffect Color="{DynamicResource Color.ControlShadow}" Direction="270" ShadowDepth="10" BlurRadius="28" Opacity=".32" /></Border.Effect>
          </Border>
          <Border Background="{DynamicResource Brush.PopupBase}" CornerRadius="{StaticResource Radius.ControlItem}">
            <Grid>
              <Border Background="{DynamicResource Brush.Control}" CornerRadius="{StaticResource Radius.ControlItem}" />
              <Border BorderBrush="{DynamicResource Brush.ControlWhite}" BorderThickness="1" CornerRadius="{StaticResource Radius.ControlItem}" Opacity=".1" />
              <Border x:Name="HoverSurface" Background="{DynamicResource Brush.ControlWhite}" CornerRadius="{StaticResource Radius.ControlItem}" Opacity="0" />
              <ContentPresenter Margin="{TemplateBinding Padding}" />
            </Grid>
          </Border>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Trigger.EnterActions><BeginStoryboard><Storyboard>
              <DoubleAnimation Storyboard.TargetName="HoverSurface" Storyboard.TargetProperty="Opacity" To=".06" Duration="0:0:0.12" />
            </Storyboard></BeginStoryboard></Trigger.EnterActions>
            <Trigger.ExitActions><BeginStoryboard><Storyboard>
              <DoubleAnimation Storyboard.TargetName="HoverSurface" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
            </Storyboard></BeginStoryboard></Trigger.ExitActions>
          </Trigger>
          <EventTrigger RoutedEvent="PreviewMouseLeftButtonDown"><BeginStoryboard><Storyboard>
            <DoubleAnimation Storyboard.TargetName="HoverSurface" Storyboard.TargetProperty="Opacity" To=".12" Duration="0:0:0.12" />
          </Storyboard></BeginStoryboard></EventTrigger>
          <EventTrigger RoutedEvent="PreviewMouseLeftButtonUp"><BeginStoryboard><Storyboard>
            <DoubleAnimation Storyboard.TargetName="HoverSurface" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
          </Storyboard></BeginStoryboard></EventTrigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value=".4" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Setter.Value></Setter>
  </Style>
</ResourceDictionary>
