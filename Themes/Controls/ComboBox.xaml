<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:MiyaIsland.Controls"
                    xmlns:p="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Focus.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <DataTemplate x:Key="FontFamilyItemTemplate">
    <TextBlock Text="{Binding Source}" FontFamily="{Binding}" FontSize="{StaticResource FontSize.Caption}"
               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
  </DataTemplate>
  <Style x:Key="ComboBox.DropDownToggle" TargetType="{x:Type p:ToggleButton}">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="ClickMode" Value="Press" />
    <Setter Property="Template"><Setter.Value>
      <ControlTemplate TargetType="{x:Type p:ToggleButton}">
        <Border Background="{DynamicResource Brush.ControlTransparent}" CornerRadius="{StaticResource Radius.S}" />
      </ControlTemplate>
    </Setter.Value></Setter>
  </Style>
  <Style x:Key="ComboBox.EditableTextBox" TargetType="{x:Type TextBox}">
    <Setter Property="Background" Value="{DynamicResource Brush.ControlTransparent}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Brush.Ink}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
    <Setter Property="Template"><Setter.Value>
      <ControlTemplate TargetType="{x:Type TextBox}">
        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden" />
      </ControlTemplate>
    </Setter.Value></Setter>
  </Style>
  <Style TargetType="{x:Type ComboBox}">
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="10,0,32,0" />
    <Setter Property="MaxDropDownHeight" Value="320" />
    <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
    <Setter Property="Background" Value="{DynamicResource Brush.Control}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Separator}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
    <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
    <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
    <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
    <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
    <Setter Property="ItemsPanel"><Setter.Value>
      <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
    </Setter.Value></Setter>
    <Setter Property="Template"><Setter.Value>
      <ControlTemplate TargetType="{x:Type ComboBox}">
        <Grid x:Name="Root" SnapsToDevicePixels="True">
          <Border x:Name="BackgroundLayer" RenderTransformOrigin=".5,.5">
            <Border.RenderTransform><ScaleTransform x:Name="BackgroundScale" /></Border.RenderTransform>
            <Grid>
              <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Radius.S}" />
              <Border x:Name="HoverSurface" Background="{DynamicResource Brush.ControlHover}" CornerRadius="{StaticResource Radius.S}" Opacity="0" />
            </Grid>
          </Border>
          <p:ToggleButton x:Name="DropDownToggle" Style="{StaticResource ComboBox.DropDownToggle}"
                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
          <ContentPresenter x:Name="SelectionPresenter" Margin="{TemplateBinding Padding}" IsHitTestVisible="False" VerticalAlignment="Center"
                            Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                            ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
          <TextBox x:Name="PART_EditableTextBox" Style="{StaticResource ComboBox.EditableTextBox}" Margin="{TemplateBinding Padding}"
                   Visibility="Collapsed" IsReadOnly="{TemplateBinding IsReadOnly}" />
          <c:IconView Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                      Data="{StaticResource Icon.ChevronDown}" Foreground="{DynamicResource Brush.Ink2}" RenderTransformOrigin=".5,.5">
            <c:IconView.RenderTransform><RotateTransform x:Name="ChevronRotation" /></c:IconView.RenderTransform>
          </c:IconView>
          <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="2" AllowsTransparency="True"
                 Focusable="False" StaysOpen="False" IsOpen="{TemplateBinding IsDropDownOpen}"
                 PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}">
            <!-- 12 DIP 外边距只承载阴影，内容区保留完整的列表宽度。 -->
            <Grid x:Name="PopupRoot" Margin="12" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
              <Grid.RenderTransform><TranslateTransform x:Name="PopupOffset" /></Grid.RenderTransform>
              <Border Background="{DynamicResource Brush.PopupBase}" CornerRadius="{StaticResource Radius.M}" IsHitTestVisible="False">
                <Border.Effect><DropShadowEffect Color="{DynamicResource Color.ControlShadow}" Direction="270" ShadowDepth="24" BlurRadius="60" Opacity=".14" /></Border.Effect>
              </Border>
              <Border Background="{DynamicResource Brush.PopupBase}" CornerRadius="{StaticResource Radius.M}" IsHitTestVisible="False">
                <Border.Effect><DropShadowEffect Color="{DynamicResource Color.ControlShadow}" Direction="270" ShadowDepth="10" BlurRadius="28" Opacity=".32" /></Border.Effect>
              </Border>
              <Border Background="{DynamicResource Brush.PopupBase}" CornerRadius="{StaticResource Radius.M}">
                <Grid>
                  <Border Background="{DynamicResource Brush.Control}" CornerRadius="{StaticResource Radius.M}" />
                  <Border BorderBrush="{DynamicResource Brush.ControlWhite}" BorderThickness="1" CornerRadius="{StaticResource Radius.M}" Opacity=".1" IsHitTestVisible="False" />
                  <ScrollViewer Style="{DynamicResource ScrollViewer.Controls}" Margin="6" MaxHeight="{TemplateBinding MaxDropDownHeight}" CanContentScroll="True"
                                HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                Focusable="False" KeyboardNavigation.DirectionalNavigation="Contained">
                    <ItemsPresenter x:Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Contained" />
                  </ScrollViewer>
                </Grid>
              </Border>
            </Grid>
          </Popup>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsEditable" Value="True">
            <Setter TargetName="SelectionPresenter" Property="Visibility" Value="Collapsed" />
            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
            <Setter Property="IsTabStop" Value="False" />
          </Trigger>
          <Trigger Property="IsMouseOver" Value="True">
            <Trigger.EnterActions><BeginStoryboard><Storyboard>
              <DoubleAnimation Storyboard.TargetName="HoverSurface" Storyboard.TargetProperty="Opacity" To=".5" Duration="0:0:0.12" />
            </Storyboard></BeginStoryboard></Trigger.EnterActions>
            <Trigger.ExitActions><BeginStoryboard><Storyboard>
              <DoubleAnimation Storyboard.TargetName="HoverSurface" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
            </Storyboard></BeginStoryboard></Trigger.ExitActions>
          </Trigger>
          <Trigger SourceName="DropDownToggle" Property="IsPressed" Value="True">
            <Trigger.EnterActions><BeginStoryboard><Storyboard>
              <DoubleAnimation Storyboard.TargetName="BackgroundScale" Storyboard.TargetProperty="ScaleX" To=".97" Duration="0:0:0.12" />
              <DoubleAnimation Storyboard.TargetName="BackgroundScale" Storyboard.TargetProperty="ScaleY" To=".97" Duration="0:0:0.12" />
            </Storyboard></BeginStoryboard></Trigger.EnterActions>
            <Trigger.ExitActions><BeginStoryboard><Storyboard>
              <DoubleAnimation Storyboard.TargetName="BackgroundScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12" />
              <DoubleAnimation Storyboard.TargetName="BackgroundScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12" />
            </Storyboard></BeginStoryboard></Trigger.ExitActions>
          </Trigger>
          <Trigger Property="IsDropDownOpen" Value="True">
            <Trigger.EnterActions><BeginStoryboard><Storyboard>
              <DoubleAnimation Storyboard.TargetName="ChevronRotation" Storyboard.TargetProperty="Angle" To="180" Duration="0:0:0.2" />
              <DoubleAnimation Storyboard.TargetName="PopupRoot" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.16" />
              <DoubleAnimation Storyboard.TargetName="PopupOffset" Storyboard.TargetProperty="Y" From="-6" To="0" Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
              </DoubleAnimation>
            </Storyboard></BeginStoryboard></Trigger.EnterActions>
            <Trigger.ExitActions><BeginStoryboard><Storyboard>
              <DoubleAnimation Storyboard.TargetName="ChevronRotation" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.2" />
            </Storyboard></BeginStoryboard></Trigger.ExitActions>
          </Trigger>
          <Trigger Property="IsEnabled" Value="False">
            <Setter TargetName="Root" Property="Opacity" Value=".4" />
            <Setter Property="IsDropDownOpen" Value="False" />
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Setter.Value></Setter>
  </Style>
  <Style TargetType="{x:Type ComboBoxItem}">
    <Setter Property="Height" Value="28" /><Setter Property="Padding" Value="8,0" />
    <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
    <Setter Property="Template"><Setter.Value>
      <ControlTemplate TargetType="{x:Type ComboBoxItem}">
        <Grid x:Name="Root" Background="{DynamicResource Brush.ControlTransparent}">
          <Border x:Name="BackgroundLayer" Background="{DynamicResource Brush.ControlTransparent}" CornerRadius="{StaticResource Radius.ControlItem}" RenderTransformOrigin=".5,.5">
            <Border.RenderTransform><ScaleTransform x:Name="BackgroundScale" /></Border.RenderTransform>
            <Border x:Name="HoverSurface" Background="{DynamicResource Brush.ControlHover}" CornerRadius="{StaticResource Radius.ControlItem}" Opacity="0" />
          </Border>
          <Grid Margin="{TemplateBinding Padding}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="22" /></Grid.ColumnDefinitions>
            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
            <c:IconView x:Name="SelectedCheck" Grid.Column="1" Width="14" Height="14" Visibility="Hidden" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Data="{StaticResource Icon.Check}" Foreground="{DynamicResource Brush.Accent}" />
          </Grid>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="SelectedCheck" Property="Visibility" Value="Visible" /></Trigger>
          <Trigger Property="IsHighlighted" Value="True">
            <Trigger.EnterActions><BeginStoryboard><Storyboard>
              <DoubleAnimation Storyboard.TargetName="HoverSurface" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
            </Storyboard></BeginStoryboard></Trigger.EnterActions>
            <Trigger.ExitActions><BeginStoryboard><Storyboard>
              <DoubleAnimation Storyboard.TargetName="HoverSurface" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
            </Storyboard></BeginStoryboard></Trigger.ExitActions>
          </Trigger>
          <EventTrigger RoutedEvent="PreviewMouseLeftButtonDown"><BeginStoryboard><Storyboard>
            <DoubleAnimation Storyboard.TargetName="BackgroundScale" Storyboard.TargetProperty="ScaleX" To=".97" Duration="0:0:0.12" />
            <DoubleAnimation Storyboard.TargetName="BackgroundScale" Storyboard.TargetProperty="ScaleY" To=".97" Duration="0:0:0.12" />
          </Storyboard></BeginStoryboard></EventTrigger>
          <EventTrigger RoutedEvent="PreviewMouseLeftButtonUp"><BeginStoryboard><Storyboard>
            <DoubleAnimation Storyboard.TargetName="BackgroundScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12" />
            <DoubleAnimation Storyboard.TargetName="BackgroundScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12" />
          </Storyboard></BeginStoryboard></EventTrigger>
          <EventTrigger RoutedEvent="MouseLeave"><BeginStoryboard><Storyboard>
            <DoubleAnimation Storyboard.TargetName="BackgroundScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12" />
            <DoubleAnimation Storyboard.TargetName="BackgroundScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12" />
          </Storyboard></BeginStoryboard></EventTrigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value=".4" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Setter.Value></Setter>
  </Style>
</ResourceDictionary>
