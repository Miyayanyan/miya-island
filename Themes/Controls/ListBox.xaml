<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Focus.xaml" />
  </ResourceDictionary.MergedDictionaries>
  <Style TargetType="{x:Type ListBox}">
    <Setter Property="Background" Value="{DynamicResource Brush.ControlTransparent}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
    <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
    <Setter Property="Template"><Setter.Value>
      <ControlTemplate TargetType="{x:Type ListBox}">
        <Grid x:Name="Root" Background="{TemplateBinding Background}">
          <ScrollViewer Style="{DynamicResource ScrollViewer.Controls}" Padding="{TemplateBinding Padding}" Focusable="False" CanContentScroll="True">
            <ItemsPresenter />
          </ScrollViewer>
        </Grid>
        <!-- 容器不重复降透明度；ListBoxItem 和 ScrollBar 各自处理禁用，避免叠乘成 16%。 -->
      </ControlTemplate>
    </Setter.Value></Setter>
  </Style>
  <Style TargetType="{x:Type ListBoxItem}">
    <Setter Property="MinHeight" Value="28" /><Setter Property="Padding" Value="8,4" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
    <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
    <Setter Property="Template"><Setter.Value>
      <ControlTemplate TargetType="{x:Type ListBoxItem}">
        <Grid x:Name="Root" Background="{DynamicResource Brush.ControlTransparent}">
          <Border x:Name="BackgroundLayer" RenderTransformOrigin=".5,.5">
            <Border.RenderTransform><ScaleTransform x:Name="BackgroundScale" /></Border.RenderTransform>
            <Grid>
              <Border x:Name="SelectedSurface" Background="{DynamicResource Brush.Lens}" CornerRadius="{StaticResource Radius.ControlItem}" Opacity="0" />
              <Border x:Name="HoverSurface" Background="{DynamicResource Brush.ControlHover}" CornerRadius="{StaticResource Radius.ControlItem}" Opacity="0" />
            </Grid>
          </Border>
          <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="SelectedSurface" Property="Opacity" Value="1" /></Trigger>
          <Trigger Property="IsMouseOver" Value="True">
            <Trigger.EnterActions><BeginStoryboard><Storyboard>
              <DoubleAnimation Storyboard.TargetName="HoverSurface" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
            </Storyboard></BeginStoryboard></Trigger.EnterActions>
            <Trigger.ExitActions><BeginStoryboard><Storyboard>
              <DoubleAnimation Storyboard.TargetName="HoverSurface" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
            </Storyboard></BeginStoryboard></Trigger.ExitActions>
          </Trigger>
          <EventTrigger RoutedEvent="PreviewMouseLeftButtonDown"><BeginStoryboard><Storyboard>
            <DoubleAnimation Storyboard.TargetName="BackgroundScale" Storyboard.TargetProperty="ScaleX" To=".97" Duration="0:0:0.12" />
            <DoubleAnimation Storyboard.TargetName="BackgroundScale" Storyboard.TargetProperty="ScaleY" To=".97" Duration="0:0:0.12" />
          </Storyboard></BeginStoryboard></EventTrigger>
          <EventTrigger RoutedEvent="PreviewMouseLeftButtonUp"><BeginStoryboard><Storyboard>
            <DoubleAnimation Storyboard.TargetName="BackgroundScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12" />
            <DoubleAnimation Storyboard.TargetName="BackgroundScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12" />
          </Storyboard></BeginStoryboard></EventTrigger>
          <EventTrigger RoutedEvent="MouseLeave"><BeginStoryboard><Storyboard>
            <DoubleAnimation Storyboard.TargetName="BackgroundScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12" />
            <DoubleAnimation Storyboard.TargetName="BackgroundScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12" />
          </Storyboard></BeginStoryboard></EventTrigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value=".4" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </Setter.Value></Setter>
  </Style>
</ResourceDictionary>
