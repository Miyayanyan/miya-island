<UserControl x:Class="MiyaIsland.Controls.TasksView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:c="clr-namespace:MiyaIsland.Controls">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,8">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBox x:Name="TitleInput" c:Placeholder.Text="添加任务…" KeyDown="Title_KeyDown"/>
      <Button x:Name="TimeButton" Grid.Column="1" MaxWidth="132" Content="不提醒" Click="Time_Click" Margin="4,0"/>
      <Button Grid.Column="2" Style="{StaticResource Button.Primary}" Width="32" Padding="0" Click="Add_Click"><c:IconView Width="16" Height="16" Data="{StaticResource Icon.Add}"/></Button>
    </Grid>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Style="{DynamicResource ScrollViewer.Controls}">
      <StackPanel><StackPanel x:Name="ActiveRows"/><TextBlock x:Name="EmptyHint" Text="还没有任务，在上面写一件吧" Foreground="{DynamicResource Brush.Ink3}" Margin="0,16"/>
        <Grid x:Name="CompletedHeader"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Button x:Name="CompletedToggle" Content="已完成 (0)" Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left" Click="Completed_Click"/>
          <Button Grid.Column="1" Content="清除" Style="{StaticResource Button.Ghost}" Click="Clear_Click"/>
        </Grid><StackPanel x:Name="CompletedRows" Visibility="Collapsed"/>
      </StackPanel>
    </ScrollViewer>
    <Popup x:Name="TimePopup" PlacementTarget="{Binding ElementName=TimeButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
      <Grid Margin="12"><Border Background="{DynamicResource Brush.PopupBase}" CornerRadius="12" IsHitTestVisible="False"><Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="10" Opacity=".32"/></Border.Effect></Border>
        <Border Background="{DynamicResource Brush.GlassSheen}" CornerRadius="12" BorderBrush="{DynamicResource Brush.IslandBorder}" BorderThickness="1" Padding="12" Width="300">
          <StackPanel>
            <TextBlock Text="提醒时间" Foreground="{DynamicResource Brush.Ink}" FontWeight="SemiBold"/>
            <ComboBox x:Name="Preset" SelectedIndex="0" SelectionChanged="Preset_Changed" Margin="0,6"><ComboBoxItem Content="不提醒"/><ComboBoxItem Content="今天（下一个整点或半点）"/><ComboBoxItem Content="明天 09:00"/><ComboBoxItem Content="自定义"/></ComboBox>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="75"/></Grid.ColumnDefinitions>
              <TextBox x:Name="DateInput" c:Placeholder.Text="yyyy-MM-dd"/><TextBox x:Name="TimeInput" Grid.Column="1" c:Placeholder.Text="HH:mm" Margin="5,0,0,0"/>
            </Grid>
            <TextBlock Text="重复" Foreground="{DynamicResource Brush.Ink2}" Margin="0,8,0,4"/>
            <StackPanel Orientation="Horizontal"><RadioButton Style="{StaticResource TaskSegment}" x:Name="RepeatNone" Content="不重复" GroupName="Repeat" IsChecked="True" Checked="Repeat_Changed"/><RadioButton Style="{StaticResource TaskSegment}" x:Name="RepeatDaily" Content="每天" GroupName="Repeat" Margin="12,0" Checked="Repeat_Changed"/><RadioButton Style="{StaticResource TaskSegment}" x:Name="RepeatWeekly" Content="每周" GroupName="Repeat" Checked="Repeat_Changed"/></StackPanel>
            <UniformGrid x:Name="Weekdays" Columns="7" Visibility="Collapsed" Margin="0,8"><ToggleButton Style="{StaticResource TaskSegment}" Content="一" Tag="1"/><ToggleButton Style="{StaticResource TaskSegment}" Content="二" Tag="2"/><ToggleButton Style="{StaticResource TaskSegment}" Content="三" Tag="3"/><ToggleButton Style="{StaticResource TaskSegment}" Content="四" Tag="4"/><ToggleButton Style="{StaticResource TaskSegment}" Content="五" Tag="5"/><ToggleButton Style="{StaticResource TaskSegment}" Content="六" Tag="6"/><ToggleButton Style="{StaticResource TaskSegment}" Content="日" Tag="0"/></UniformGrid>
            <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Brush.Overdue}" TextWrapping="Wrap" Margin="0,6"/>
            <Button Content="确定" Style="{StaticResource Button.Primary}" HorizontalAlignment="Right" Click="ApplyTime_Click"/>
          </StackPanel>
        </Border>
      </Grid>
    </Popup>
  </Grid>
</UserControl>
