<Window x:Class="MiyaIsland.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Miya Island 设置" Width="760" Height="520" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" FontFamily="{StaticResource Font.UI}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale" Loaded="Window_Loaded">
  <Grid Margin="16">
    <Border CornerRadius="26" Background="{DynamicResource Brush.SettingsBase}" IsHitTestVisible="False"><Border.Effect><DropShadowEffect Color="{DynamicResource Color.GlassShadow}" BlurRadius="34" ShadowDepth="10" Opacity="{DynamicResource Glass.ShadowOpacity}"/></Border.Effect></Border>
    <Grid x:Name="BackdropLayer" Visibility="Collapsed" IsHitTestVisible="False" ClipToBounds="True"><Grid.Clip><RectangleGeometry Rect="0,0,728,488" RadiusX="26" RadiusY="26"/></Grid.Clip><Image x:Name="BackdropImage" Width="760" Height="520" Margin="-16,-16,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Stretch="Fill"/><Border Background="{DynamicResource Brush.SettingsBase}"/></Grid>
    <Border CornerRadius="26" Opacity=".08" IsHitTestVisible="False"><Border.Background><ImageBrush ImageSource="pack://application:,,,/MiyaIsland;component/Assets/noise.png" TileMode="Tile" Stretch="None" Viewport="0,0,128,128" ViewportUnits="Absolute"/></Border.Background></Border>
    <Border CornerRadius="26" BorderBrush="{DynamicResource Brush.GlassEdge}" BorderThickness="6" IsHitTestVisible="False"><Border.Effect><BlurEffect Radius="22"/></Border.Effect></Border>
    <Border CornerRadius="26" Background="{DynamicResource Brush.GlassSheen}" IsHitTestVisible="False"/>
    <Border CornerRadius="26" BorderBrush="{DynamicResource Brush.GlassRimTopLeft}" BorderThickness="1.2" IsHitTestVisible="False"/>
    <Border CornerRadius="26" BorderBrush="{DynamicResource Brush.GlassRimBottomRight}" BorderThickness="1.2" IsHitTestVisible="False"/>
    <Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid MouseLeftButtonDown="Header_MouseDown"><TextBlock Text="Miya Island · 设置" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" VerticalAlignment="Center"/><Button Style="{StaticResource Button.Icon}" Width="28" Height="28" HorizontalAlignment="Right" Content="×" Click="Close_Click"/></Grid>
      <Grid Grid.Row="1" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel x:Name="Navigation" Margin="0,0,14,0"/>
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="Page" Margin="0,0,6,0"/></ScrollViewer>
      </Grid>
    </Grid>
  </Grid>
</Window>