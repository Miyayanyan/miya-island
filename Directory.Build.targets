<Project>
  <!-- WPF 编译还会生成临时项目，排除规则也必须覆盖它。 -->
  <ItemGroup Condition="'$(UseWPF)' == 'true'">
    <Compile Remove="tests\**\*.cs" />
    <EmbeddedResource Remove="tests\**\*" />
    <None Remove="tests\**\*" />
    <None Remove="Assets\greetings.zh-CN.json" />
    <EmbeddedResource Include="Assets\greetings.zh-CN.json" LogicalName="MiyaIsland.Assets.greetings.zh-CN.json" WithCulture="false" Condition="Exists('Assets\greetings.zh-CN.json')" />
  </ItemGroup>
</Project>

