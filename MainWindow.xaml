<Window x:Class="MiyaIsland.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:MiyaIsland.Controls"
        Title="Miya Island"
        Width="478" Height="400"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        FontFamily="{StaticResource Font.UI}" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale"
        Loaded="Window_Loaded">
  <Window.Resources>
    <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
      <Setter Property="Height" Value="30"/><Setter Property="Margin" Value="0"/><Setter Property="Padding" Value="0"/>
      <Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink2}"/>
    </Style>
    <Style x:Key="SettingRow" TargetType="Border"><Setter Property="MinHeight" Value="38"/><Setter Property="BorderBrush" Value="{DynamicResource Brush.Separator}"/><Setter Property="BorderThickness" Value="0,0,0,1"/></Style>
  </Window.Resources>

  <!--
    固定画布：窗口大小不随展开 / 收起变化，四周留出阴影边距。
    透明像素会把鼠标点击穿透给下面的窗口，只有岛本身（和很淡的阴影）接收鼠标。
  -->
  <Grid x:Name="IslandCanvas" Width="478" Height="400">
    <Grid.LayoutTransform>
      <ScaleTransform x:Name="IslandScaleTransform" ScaleX="1" ScaleY="1" />
    </Grid.LayoutTransform>

    <Grid x:Name="IslandHost" Width="210" Height="42" Margin="0,24,0,0"
          HorizontalAlignment="Center" VerticalAlignment="Top"
          MouseRightButtonUp="Island_RightClick" MouseEnter="Island_MouseEnter" MouseLeave="Island_MouseLeave" PreviewMouseLeftButtonDown="Compact_MouseDown" PreviewMouseMove="Compact_MouseMove" PreviewMouseLeftButtonUp="Compact_MouseUp">
      <!-- L0 投影板 + L1 底色：Effect 只加在这里，不包住任何文字 -->
      <Border x:Name="ShadowPlate" CornerRadius="21" IsHitTestVisible="False"
              Background="{DynamicResource Brush.IslandBase}">
        <Border.Effect>
          <DropShadowEffect x:Name="IslandShadow" Color="{DynamicResource Color.GlassShadow}" Direction="270" ShadowDepth="4"
                            BlurRadius="18" Opacity="0.38" RenderingBias="Performance" />
        </Border.Effect>
      </Border>

      <Border x:Name="IslandBorder" CornerRadius="21" Background="Transparent">
        <Grid>
          <Grid x:Name="BackdropLayer" Visibility="Collapsed" IsHitTestVisible="False" ClipToBounds="True"><Image x:Name="BackdropImage" Width="478" Height="400" HorizontalAlignment="Left" VerticalAlignment="Top" Stretch="Fill"/><Border Background="{DynamicResource Brush.IslandBase}"/></Grid>
          <!-- L2 颗粒 -->
          <Border CornerRadius="{Binding CornerRadius, ElementName=IslandBorder}" Opacity="0.08" IsHitTestVisible="False">
            <Border.Background>
              <ImageBrush ImageSource="pack://application:,,,/MiyaIsland;component/Assets/noise.png" TileMode="Tile" Stretch="None"
                          Viewport="0,0,128,128" ViewportUnits="Absolute" />
            </Border.Background>
          </Border>
          <!-- L4 顶亮底暗的体积感 -->
          <Border CornerRadius="{Binding CornerRadius, ElementName=IslandBorder}" IsHitTestVisible="False"
                  Background="{DynamicResource Brush.GlassSheen}" />
          <!-- L3 液化边缘光晕带：粗细和模糊随高度变化（GlassPolicy） -->
          <Border x:Name="GlassEdge" CornerRadius="{Binding CornerRadius, ElementName=IslandBorder}" IsHitTestVisible="False"
                  BorderBrush="{DynamicResource Brush.GlassEdge}" BorderThickness="3">
            <Border.Effect>
              <BlurEffect x:Name="GlassEdgeBlur" Radius="8" RenderingBias="Performance" />
            </Border.Effect>
          </Border>
          <Border x:Name="Dispersion" Opacity="0" BorderThickness="2.5" IsHitTestVisible="False"><Border.BorderBrush><DrawingBrush><DrawingBrush.Drawing><DrawingGroup><GeometryDrawing><GeometryDrawing.Brush><RadialGradientBrush Center="0,.5" GradientOrigin="0,.5" RadiusX=".6" RadiusY="1.4"><GradientStop Color="#E6FF78BE" Offset="0"/><GradientStop Color="#00000000" Offset=".7"/></RadialGradientBrush></GeometryDrawing.Brush><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry></GeometryDrawing><GeometryDrawing><GeometryDrawing.Brush><RadialGradientBrush Center="1,.4" GradientOrigin="1,.4" RadiusX=".6" RadiusY="1.4"><GradientStop Color="#E6A082FF" Offset="0"/><GradientStop Color="#00000000" Offset=".7"/></RadialGradientBrush></GeometryDrawing.Brush><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry></GeometryDrawing><GeometryDrawing><GeometryDrawing.Brush><RadialGradientBrush Center=".6,0" GradientOrigin=".6,0" RadiusX=".5" RadiusY="1.2"><GradientStop Color="#CCFFBE96" Offset="0"/><GradientStop Color="#00000000" Offset=".7"/></RadialGradientBrush></GeometryDrawing.Brush><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1"/></GeometryDrawing.Geometry></GeometryDrawing></DrawingGroup></DrawingBrush.Drawing></DrawingBrush></Border.BorderBrush><Border.Effect><BlurEffect Radius="1.4"/></Border.Effect></Border>
          <Border CornerRadius="{Binding CornerRadius, ElementName=IslandBorder}" BorderBrush="{DynamicResource Brush.GlassInnerDark}" BorderThickness="0,0,2,3" IsHitTestVisible="False"><Border.Effect><BlurEffect Radius="18"/></Border.Effect></Border>
          <Border CornerRadius="{Binding CornerRadius, ElementName=IslandBorder}" BorderBrush="{DynamicResource Brush.GlassInnerLight}" BorderThickness="1" IsHitTestVisible="False"><Border.Effect><BlurEffect Radius="2.4"/></Border.Effect></Border>
          <!-- L5/L6 双向高光描边：左上亮、右下次亮 -->
          <Border CornerRadius="{Binding CornerRadius, ElementName=IslandBorder}" IsHitTestVisible="False"
                  BorderThickness="1.2" BorderBrush="{DynamicResource Brush.GlassRimTopLeft}" />
          <Border CornerRadius="{Binding CornerRadius, ElementName=IslandBorder}" IsHitTestVisible="False"
                  BorderThickness="1.2" BorderBrush="{DynamicResource Brush.GlassRimBottomRight}" />

      <StackPanel x:Name="CompactContent" Orientation="Horizontal" Margin="28,0,8,0" VerticalAlignment="Center" HorizontalAlignment="Left" Opacity="0" IsHitTestVisible="False">
        <StackPanel x:Name="Equalizer" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0"><Rectangle x:Name="Bar1" Width="2" Height="5" Fill="{DynamicResource Brush.Ink2}" Margin="0,0,2,0"/><Rectangle x:Name="Bar2" Width="2" Height="11" Fill="{DynamicResource Brush.Ink2}" Margin="0,0,2,0"/><Rectangle x:Name="Bar3" Width="2" Height="7" Fill="{DynamicResource Brush.Ink2}"/></StackPanel>
        <TextBlock x:Name="CompactClock" FontSize="11" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource Brush.Ink}" VerticalAlignment="Center"/>
      </StackPanel>
        <Ellipse x:Name="PillReminderDot" Width="6" Height="6" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0" Visibility="Collapsed" IsHitTestVisible="False"/>
        <c:AvatarView x:Name="IslandAvatar" Width="26" Height="26" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed"/>
        <Ellipse x:Name="StatusIndicator" Width="9" Height="9" Fill="{StaticResource Accent}"
                 VerticalAlignment="Top" HorizontalAlignment="Left" Margin="12,16.5,0,0" RenderTransformOrigin="0.5,0.5">
          <Ellipse.RenderTransform>
            <ScaleTransform x:Name="IndicatorScaleTransform" ScaleX="1" ScaleY="1" />
          </Ellipse.RenderTransform>
        </Ellipse>
      <Grid x:Name="HeaderContent" VerticalAlignment="Top" Height="42" Margin="12,0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
        <Grid.ColumnDefinitions><ColumnDefinition Width="9"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <DockPanel Grid.Column="1" Margin="9,0,7,0">
          <c:IconView x:Name="RestLockIcon" DockPanel.Dock="Right" Width="12" Height="12" Margin="4,0,0,0" Foreground="{DynamicResource Brush.Ink3}" Data="{StaticResource Icon.Lock}" Visibility="Collapsed"/>
          <c:IconView x:Name="CompactIcon" DockPanel.Dock="Left" Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Ink2}" Data="{StaticResource Icon.Music}" Visibility="Collapsed"/>
          <Grid VerticalAlignment="Center"><TextBlock x:Name="CompactText" Text="Miya Island" Foreground="{DynamicResource Brush.Ink}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="HeaderTitleNext" Foreground="{DynamicResource Brush.Ink2}" FontSize="13" FontWeight="SemiBold" FontFamily="{Binding FontFamily, ElementName=CompactText}" Opacity="0" TextTrimming="CharacterEllipsis" IsHitTestVisible="False"/></Grid>
        </DockPanel>
        <Button x:Name="IslandLockButton" Grid.Column="2" Style="{StaticResource Button.Icon}" Width="28" Height="28" Padding="0" ToolTip="锁定灵动岛位置" Click="IslandLock_Click" Visibility="Collapsed"><c:IconView x:Name="IslandLockIcon" Width="18" Height="18" Data="{StaticResource Icon.Unlock}"/></Button>
        <Button x:Name="HeaderCollapseButton" Grid.Column="4" Style="{StaticResource Button.Icon}" Width="28" Height="28" Padding="0" ToolTip="收起" Click="CompactMode_Click" Visibility="Collapsed"><c:IconView x:Name="HeaderChevron" Width="18" Height="18" Data="{StaticResource Icon.ChevronUp}"/></Button>
      </Grid>

      <Grid x:Name="GreetingContent" Width="400" Height="72" HorizontalAlignment="Center" VerticalAlignment="Top" Opacity="0" IsHitTestVisible="False" MouseLeftButtonUp="Greeting_Click">
        <StackPanel x:Name="GreetingWords" Margin="38,0,18,0" VerticalAlignment="Center"><TextBlock x:Name="GreetingTitle" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="GreetingSubtitle" FontSize="11.5" Foreground="{DynamicResource Brush.Ink2}" Typography.NumeralAlignment="Tabular" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/></StackPanel>
        <Border Height="2" Margin="24,0,24,7" VerticalAlignment="Bottom" Background="{DynamicResource Brush.Separator}"><Border Background="{DynamicResource Brush.Primary}" RenderTransformOrigin="0,0"><Border.RenderTransform><ScaleTransform x:Name="GreetingProgress"/></Border.RenderTransform></Border></Border>
      </Grid>
      <Grid x:Name="ReminderContent" Width="356" Height="112" Margin="0,12,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" Opacity="0" IsHitTestVisible="False">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border x:Name="ReminderBell" Width="30" Height="30" CornerRadius="15" Background="{DynamicResource Brush.Lens}" BorderBrush="{DynamicResource Brush.LensBorder}" BorderThickness="1" VerticalAlignment="Top"><c:IconView Width="16" Height="16" Data="{StaticResource Icon.Bell}" Foreground="{DynamicResource Brush.Ink}"/></Border>
          <StackPanel Grid.Column="1"><TextBlock x:Name="ReminderCardTitle" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="ReminderCardTime" FontSize="12" Foreground="{DynamicResource Brush.Ink2}" Margin="0,6,0,0"/></StackPanel>
        </Grid>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="忽略" Style="{StaticResource Button.Ghost}" Click="DismissReminder_Click"/><Button Content="延后 ▾" Click="SnoozeReminder_Click"/><Button Content="完成" Style="{StaticResource Button.Primary}" Click="CompleteReminder_Click"/></StackPanel>
      </Grid>
      <!-- 展开内容按最终尺寸排版，变形过程中只被裁剪，不会重排 -->
      <Grid x:Name="ExpandedContent" Width="402" Height="286" Margin="0,52,0,0" Opacity="0"
            HorizontalAlignment="Center" VerticalAlignment="Top"
            Background="Transparent" MouseLeftButtonDown="ExpandedContent_MouseLeftButtonDown">
        <Grid.RenderTransform>
          <TranslateTransform x:Name="ExpandedContentShift" />
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
          <RowDefinition Height="44" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Height="34" VerticalAlignment="Top" CornerRadius="17" Background="{DynamicResource Brush.Well}" Padding="2">
          <Grid x:Name="NavTrack" PreviewKeyDown="NavTrack_KeyDown">
            <Border x:Name="NavLens" Height="32" Width="79.6" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="16" Background="{DynamicResource Brush.Lens}" BorderBrush="{DynamicResource Brush.LensBorder}" BorderThickness="1" IsHitTestVisible="False">
              <Border.RenderTransform><TranslateTransform x:Name="NavLensPosition"/></Border.RenderTransform>
              <Border CornerRadius="16" BorderBrush="{DynamicResource Brush.LensInnerHighlight}" BorderThickness="0,1,0,0"/>
            </Border>
            <UniformGrid Columns="5"><Button x:Name="NavMusic" Style="{StaticResource NavButton}" Click="MusicTab_Click" ToolTip="音乐" AutomationProperties.Name="音乐"><c:IconView x:Name="NavMusicIcon" Width="20" Height="20" Data="{StaticResource Icon.Music}"/></Button><Button x:Name="NavTasks" Style="{StaticResource NavButton}" Click="ReminderTab_Click" ToolTip="任务" AutomationProperties.Name="任务"><c:IconView x:Name="NavTasksIcon" Width="20" Height="20" Data="{StaticResource Icon.Tasks}"/></Button><Button x:Name="NavDownload" Style="{StaticResource NavButton}" Click="DownloadTab_Click" ToolTip="下载" AutomationProperties.Name="下载"><c:IconView x:Name="NavDownloadIcon" Width="20" Height="20" Data="{StaticResource Icon.Download}"/></Button><Button x:Name="NavScreenshot" Style="{StaticResource NavButton}" Click="ScreenshotTab_Click" ToolTip="截图" AutomationProperties.Name="截图"><c:IconView x:Name="NavScreenshotIcon" Width="20" Height="20" Data="{StaticResource Icon.Screenshot}"/></Button><Button x:Name="NavSettings" Style="{StaticResource NavButton}" Click="SettingsTab_Click" ToolTip="设置" AutomationProperties.Name="设置"><c:IconView x:Name="NavSettingsIcon" Width="20" Height="20" Data="{StaticResource Icon.Settings}"/></Button></UniformGrid></Grid></Border>

        <Grid Grid.Row="1">
          <Grid x:Name="MusicPanel">
            <Grid.RowDefinitions><RowDefinition Height="20"/><RowDefinition Height="50"/><RowDefinition Height="24"/><RowDefinition Height="Auto"/><RowDefinition Height="36"/></Grid.RowDefinitions>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" MaxWidth="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock x:Name="SongTitle" Text="没有正在播放的音乐" Foreground="{DynamicResource Brush.Ink}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="SongArtist" Grid.Column="1" Text="" Foreground="{DynamicResource Brush.Ink2}" FontSize="12" Margin="8,1,0,0" TextTrimming="CharacterEllipsis"/>
            </Grid>
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,4">
              <Button Style="{StaticResource Button.Icon}" Width="28" Height="28" Margin="0,0,14,0" ToolTip="上一首" Click="Previous_Click"><c:IconView Width="18" Height="18" Data="{StaticResource Icon.Prev}"/></Button>
              <Button x:Name="PlayButton" Style="{StaticResource Button.Lens}" Width="40" Height="40" Margin="0" ToolTip="播放 / 暂停" Click="Play_Click"><c:IconView x:Name="PlayIcon" Width="20" Height="20" Data="{StaticResource Icon.Play}"/></Button>
              <Button Style="{StaticResource Button.Icon}" Width="28" Height="28" Margin="14,0,0,0" ToolTip="下一首" Click="Next_Click"><c:IconView Width="18" Height="18" Data="{StaticResource Icon.Next}"/></Button>
            </StackPanel>
            <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
              <c:IconView Width="16" Height="16" Data="{StaticResource Icon.Volume}" Foreground="{DynamicResource Brush.Ink2}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
              <Slider x:Name="VolumeSlider" Grid.Column="1" Minimum="0" Maximum="100" Margin="8,0" ValueChanged="VolumeSlider_ValueChanged"/>
              <TextBlock x:Name="VolumeText" Grid.Column="2" FontSize="11" Foreground="{DynamicResource Brush.Ink2}" Text="0%" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>
            <Border x:Name="LyricWell" Grid.Row="3" Background="{DynamicResource Brush.Well}" CornerRadius="14" Margin="0,8,0,0" Padding="12,8" MouseLeftButtonUp="LyricWell_MouseLeftButtonUp">
              <StackPanel>
                <TextBlock x:Name="PreviousLyricText" Text="" Foreground="{DynamicResource Brush.Ink3}" FontSize="11" Height="16" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="CurrentLyricText" Text="播放音乐后自动匹配歌词" Foreground="{DynamicResource Brush.Lyric}" FontSize="15" Height="22" FontWeight="SemiBold" Margin="0,2" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="NextLyricText" Text="" Foreground="{DynamicResource Brush.Ink3}" FontSize="11" Height="16" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </Border>
            <Grid Grid.Row="4" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock x:Name="PlaybackTimeText" Text="0:00 / 0:00" Foreground="{DynamicResource Brush.Ink3}" FontSize="11" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center"/>
              <Button x:Name="FloatingLyricsButton" Grid.Column="1" Height="28" Margin="0,0,6,0" Click="FloatingLyrics_Click"><StackPanel Orientation="Horizontal"><c:IconView Width="15" Height="15" Margin="0,0,5,0" Data="{StaticResource Icon.Lyrics}"/><TextBlock Text="悬浮歌词"/></StackPanel></Button>
              <Button Grid.Column="2" Height="28" Margin="0" Click="ImportLyrics_Click"><StackPanel Orientation="Horizontal"><c:IconView Width="15" Height="15" Margin="0,0,5,0" Data="{StaticResource Icon.Add}"/><TextBlock Text="导入 LRC"/></StackPanel></Button>
            </Grid>
          </Grid>

          <Grid x:Name="ReminderPanel" Visibility="Collapsed"><c:TasksView x:Name="TasksPanel"/></Grid>

                    <Grid x:Name="DownloadPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="新建下载" Foreground="White" FontSize="{StaticResource FontSize.Headline}" FontWeight="SemiBold" />
            <TextBox x:Name="DownloadUrlInput" Grid.Row="1" Margin="0,9,0,6" c:Placeholder.Text="粘贴 http 或 https 下载链接" />
            <Button Grid.Row="2" Style="{StaticResource Button.Primary}" HorizontalAlignment="Left" Content="选择保存位置并开始" Click="StartDownload_Click" />
            <Border Grid.Row="3" Background="{DynamicResource Brush.Well}" CornerRadius="14" Padding="12,10" Margin="0,10,0,0">
              <StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="DownloadStatus" Text="暂无下载" Foreground="{DynamicResource Brush.Ink}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="DownloadDetail" Grid.Column="1" Foreground="{DynamicResource Brush.Ink2}" FontSize="11" Typography.NumeralAlignment="Tabular" Margin="8,0,0,0"/>
              </Grid><ProgressBar x:Name="DownloadProgress" Height="4" Margin="0,6,0,0" Maximum="100"/></StackPanel>
            </Border>
          </Grid>

          <Grid x:Name="ScreenshotPanel" Visibility="Collapsed"><StackPanel>
            <TextBlock Text="截图" Foreground="{DynamicResource Brush.Ink}" FontSize="{StaticResource FontSize.Headline}" FontWeight="SemiBold"/>
            <TextBlock FontSize="12" Text="框选区域、窗口或整个屏幕，截完会自动复制到剪贴板。" Foreground="{DynamicResource Brush.Ink2}" TextWrapping="Wrap" Margin="0,8,0,12"/>
            <Button Style="{StaticResource Button.Primary}" HorizontalAlignment="Left" Click="Screenshot_Click"><StackPanel Orientation="Horizontal"><c:IconView Width="16" Height="16" Data="{StaticResource Icon.Screenshot}" Margin="0,0,6,0"/><TextBlock Text="开始截图"/></StackPanel></Button>
            <TextBlock Text="也可以随时按 Win + Shift + S" Foreground="{DynamicResource Brush.Ink3}" Margin="0,12,0,0"/>
          </StackPanel></Grid>

          <Grid x:Name="SettingsPanel" Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="0,0,5,0">
                <Border Style="{StaticResource SettingRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Text="呼吸灯" Foreground="{DynamicResource Brush.Ink}" VerticalAlignment="Center" FontSize="13"/>
                  <ComboBox x:Name="BreathingSpeedCombo" Grid.Column="1" Width="80" SelectionChanged="AppearanceControl_Changed"><ComboBoxItem Content="慢速"/><ComboBoxItem Content="正常"/><ComboBoxItem Content="快速"/></ComboBox>
                  <CheckBox x:Name="BreathingCheck" Grid.Column="2" Style="{StaticResource ToggleSwitch}" Margin="6,0,0,0" VerticalAlignment="Center" Checked="AppearanceControl_Changed" Unchecked="AppearanceControl_Changed"/>
                </Grid></Border>
                <Border Style="{StaticResource SettingRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                  <TextBlock Text="小岛大小" Foreground="{DynamicResource Brush.Ink}" VerticalAlignment="Center"/>
                  <Slider x:Name="ScaleSlider" Grid.Column="1" Minimum="70" Maximum="160" ValueChanged="ScaleSlider_ValueChanged"/>
                  <TextBlock x:Name="ScaleValueText" Grid.Column="2" Text="100%" FontSize="11" Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource Brush.Ink2}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid></Border>
                <Border Style="{StaticResource SettingRow}"><CheckBox x:Name="AutoCollapseCheck" Content="鼠标离开后自动收起" Style="{StaticResource ToggleSwitch}" Checked="AppearanceControl_Changed" Unchecked="AppearanceControl_Changed"/></Border>
                <Border Style="{StaticResource SettingRow}"><CheckBox x:Name="QuietModeCheck" Content="安静模式" Style="{StaticResource ToggleSwitch}" Checked="QuietMode_Changed" Unchecked="QuietMode_Changed"/></Border>
                <Border Style="{StaticResource SettingRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
                  <TextBlock Text="收起样式" Foreground="{DynamicResource Brush.Ink}" VerticalAlignment="Center"/>
                  <TextBlock x:Name="QuietRestHint" Grid.Column="1" Text="安静模式中" Visibility="Collapsed" Foreground="{DynamicResource Brush.Ink3}" VerticalAlignment="Center" HorizontalAlignment="Right"/><ComboBox x:Name="RestStyleCombo" Grid.Column="1" SelectionChanged="AppearanceControl_Changed"><ComboBoxItem Content="普通条"/><ComboBoxItem Content="小胶囊"/><ComboBoxItem Content="小圆"/></ComboBox>
                </Grid></Border>
                <Border Style="{StaticResource SettingRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions><TextBlock Text="玻璃风格" Foreground="{DynamicResource Brush.Ink}" VerticalAlignment="Center"/><ContentControl x:Name="GlassPickerHost" Grid.Column="1"/></Grid></Border>
                <Expander x:Name="LegacyAppearanceControls" Visibility="Collapsed" Header="更多外观设置" Foreground="{DynamicResource Brush.Ink2}" Margin="0,6">
                  <StackPanel>
                    <TextBlock Text="待机标题" Foreground="{DynamicResource Brush.Ink2}"/><TextBox x:Name="TitleInput" c:Placeholder.Text="Miya Island" TextChanged="AppearanceControl_Changed"/>
                    <TextBlock Text="标题字体" Foreground="{DynamicResource Brush.Ink2}" Margin="0,6,0,0"/><ComboBox x:Name="FontFamilyCombo" ItemTemplate="{StaticResource FontFamilyItemTemplate}" SelectionChanged="AppearanceControl_Changed"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6"><Button x:Name="TitleColorButton" Content="文字颜色" Click="ChooseTitleColor_Click"/><Button x:Name="IndicatorColorButton" Content="指示灯颜色" Click="ChooseIndicatorColor_Click"/><Button Content="恢复默认" Click="ResetAppearance_Click"/></StackPanel>
                  </StackPanel>
                </Expander>
                <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel Orientation="Horizontal"><Button Content="完整设置" Style="{StaticResource Button.Primary}" Height="28" Margin="0,0,6,0" Click="FullSettings_Click"/><Button Content="重新居中" Height="28" Margin="0" Click="CenterWindow_Click"/></StackPanel>
                  <Button Grid.Column="2" Style="{StaticResource Button.Danger}" Height="28" Margin="0" Content="退出" Click="Exit_Click"/>
                </Grid>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Grid>
      </Grid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
